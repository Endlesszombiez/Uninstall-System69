<Window x:Class="System69.App.ReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Review uninstall queue" Width="900" Height="590" MinWidth="750" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Check the apps and exact cleanup folders before you continue." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <DataGrid x:Name="ReviewGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderBrush="#DFE7E3" BorderThickness="1"><DataGrid.Columns><DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="170"/><DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="110"/><DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="135"/><DataGridTemplateColumn Header="CLEANUP" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Cleanup}" TextWrapping="Wrap" FontSize="11"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Margin="0,18,0,18"><TextBlock x:Name="Warning" TextWrapping="Wrap" FontSize="12" Foreground="#865B1C"/><CheckBox x:Name="Acknowledge" Content="I have reviewed this list and want to uninstall these apps." Margin="0,14,0,0"/></StackPanel>
    <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" IsCancel="True"/><Button Content="Uninstall apps" Style="{StaticResource Primary}" IsEnabled="{Binding IsChecked, ElementName=Acknowledge}" Click="Confirm_Click"/></StackPanel>
  </Grid>
</Window>
